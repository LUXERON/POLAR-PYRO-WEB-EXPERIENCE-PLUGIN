{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxeron.dev/schemas/web-experience/ux-binding-1.0.json",
  "title": "UXBinding",
  "type": "object",
  "required": ["schema_version", "application_id", "archetype", "navigation", "density", "tone", "priorities", "view_recipes", "design_precedent", "evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "application_id": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
    "archetype": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
    "navigation": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
    "density": {"type": "string", "enum": ["comfortable", "compact", "dense"]},
    "tone": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
    "priorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"}},
    "view_recipes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"}},
    "design_precedent": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "[0-9a-f]{64}"}}
  }
}
