{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxeron.dev/schemas/web-experience/ui-plan-1.0.json",
  "title": "UIPlan",
  "type": "object",
  "required": ["schema_version", "application_id", "design_language_id", "ux_contract_sha256", "component_catalog_sha256", "routes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "application_id": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
    "design_language_id": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
    "ux_contract_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "component_catalog_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "routes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["route_id", "recipe_id", "regions"], "additionalProperties": false, "properties": {
      "route_id": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
      "recipe_id": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
      "regions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "component_id", "query_ids", "command_ids", "children"], "additionalProperties": false, "properties": {
        "id": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
        "component_id": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"},
        "query_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"}},
        "command_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9._-]*"}},
        "children": {"type": "array", "maxItems": 0}
      }}}
    }} }
  }
}
